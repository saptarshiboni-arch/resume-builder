# Flask Configuration
PORT=5000
FLASK_ENV=development
DEBUG=True

# AI Provider Configuration (Optional - safe mock fallback is used if omitted)
# Supports Gemini or OpenAI-compatible endpoints
AI_PROVIDER=gemini # or 'openai'
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash # or 'gpt-4o-mini'
